{
  "name": "s-chat",
  "productName": "S-Chat",
  "version": "1.0.0",
  "description": "S-Chat masaustu uygulamasi",
  "author": "S-Chat",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.schat.desktop",
    "productName": "S-Chat",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", "icon.ico", "package.json"],
    "win": {
      "icon": "icon.ico",
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "S-Chat"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
